# --- Backend (Render) ---
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Google Cloud Console > Credentials > OAuth 2.0 Client > Authorized redirect URIs
REDIRECT_URI=https://personal-email-assistant-api.onrender.com/api/auth/callback
FRONTEND_URL=https://personal-email-assistant-2.vercel.app
# Optional: comma-separated additional CORS origins
# CORS_ALLOWED_ORIGINS=https://preview--your-frontend.vercel.app
# Free tier uses ephemeral /tmp (data resets on deploy/restart - no disk)
DB_PATH=/tmp/emails.db
CHROMA_DB_PATH=/tmp/chroma_db
# Port is injected by Render
PORT=8000

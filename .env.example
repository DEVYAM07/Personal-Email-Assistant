# --- Backend (Render) ---
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Google Cloud Console > Credentials > OAuth 2.0 Client > Authorized redirect URIs
# For production, set to your Render URL e.g., https://your-backend.onrender.com/api/auth/callback
REDIRECT_URI=http://localhost:8000/api/auth/callback
# Frontend URL for CORS and OAuth redirect (injected via env on Render)
# e.g., https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated additional CORS origins
# CORS_ALLOWED_ORIGINS=https://preview--your-frontend.vercel.app
# Render Free Tier: ephemeral FS (resets on deploy), or mounted disk at /data for persistence
DB_PATH=./emails.db
CHROMA_DB_PATH=./chroma_db
# Render injects PORT; default 8000 for local dev
PORT=8000
# Sync batch size (100 emails full sync)
SYNC_BATCH_SIZE=100

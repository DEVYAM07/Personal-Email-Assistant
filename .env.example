# --- Backend (Render / Railway) ---
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Google Cloud Console > Credentials > OAuth 2.0 Client > Authorized redirect URIs
REDIRECT_URI=https://your-api.onrender.com/api/auth/callback
FRONTEND_URL=https://your-frontend.vercel.app
# Optional: comma-separated additional CORS origins
# CORS_ALLOWED_ORIGINS=https://preview--your-frontend.vercel.app
# Persistence (Render disk mounts at /data, Railway volume at /data)
DB_PATH=/data/emails.db
CHROMA_DB_PATH=/data/chroma_db
# Port is injected by Render/Railway
PORT=8000
